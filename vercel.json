{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.irripump.com" }],
      "destination": "https://irripump.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "boropump.com" }],
      "destination": "https://irripump.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.boropump.com" }],
      "destination": "https://irripump.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
